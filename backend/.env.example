################################################################################
# iTrip Backend Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
################################################################################

# ==============================================================================
# APPLICATION
# ==============================================================================
APP_NAME="iTrip AI Command Center"
DEBUG=false
ENVIRONMENT=development

# ==============================================================================
# DATABASE
# ==============================================================================
# SQLite for development:
DATABASE_URL="sqlite:///./itrip.db"

# PostgreSQL for production (uncomment to use):
# DATABASE_URL="postgresql://user:password@localhost:5432/itrip"

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-me-to-a-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# AI PROVIDER CONFIGURATION
# ==============================================================================
# Choose one provider: "openai", "anthropic", or "gemini"
AI_PROVIDER="openai"

# AI_PROVIDER=openai
# Models: gpt-4, gpt-4-turbo, gpt-4-32k, gpt-3.5-turbo
OPENAI_API_KEY="sk-proj-..."

# AI_PROVIDER=anthropic
# Models: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
ANTHROPIC_API_KEY="sk-ant-..."

# AI_PROVIDER=gemini
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_API_KEY="AIza..."

# ==============================================================================
# VECTOR SEARCH (Qdrant)
# ==============================================================================
# URL to Qdrant instance (local Docker: http://localhost:6333)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="itrip_documents"

# Embedding model (OpenAI text-embedding-3-small or text-embedding-3-large)
EMBEDDING_MODEL="text-embedding-3-small"

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# CORS - allowed frontend origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://itrip-frontend-production.up.railway.app"

# URLs
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"

# ==============================================================================
# FILE UPLOAD CONFIGURATION
# ==============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES="docx,xlsx,pdf"
UPLOAD_DIRECTORY="./uploads"

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL="INFO"
LOG_FILE="./logs/app.log"

# ==============================================================================
# EMAIL (Optional - for future guest reply sending)
# ==============================================================================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-specific-password"
# SMTP_FROM="noreply@itrip.com"

################################################################################
# NOTES:
#
# 1. Generate SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Get API Keys:
#    - OpenAI: https://platform.openai.com/account/api-keys
#    - Anthropic: https://console.anthropic.com/account/keys
#    - Google Gemini: https://aistudio.google.com/app/apikey
#
# 3. Start Qdrant Docker container:
#    docker-compose up -d
#
# 4. For production:
#    - Use PostgreSQL database
#    - Set DEBUG=false and ENVIRONMENT=production
#    - Use strong SECRET_KEY (32+ characters)
#    - Use environment-specific API keys
#    - Set CORS origins correctly
#
################################################################################
